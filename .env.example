# Copie para ".env" (que NÃO vai para o GitHub) e preencha com os dados do seu projeto Supabase:
# Supabase > Project Settings > API (ou Connect).
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co

# Use SOMENTE a chave pública (publishable "sb_publishable_..." ou a "anon" legada).
# NUNCA coloque aqui a chave service_role / secret: ela iria para o bundle do navegador.
VITE_SUPABASE_PUBLISHABLE_KEY=
